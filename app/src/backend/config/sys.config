[
    {gettic, [
        {port, 8080},
        {ws_port, 8080},
        {backend_url, ""},
        {frontend_url, "https://gettic.js.org"},
        {database, [
            {host, ""},
            {port, 3306},
            {user, "gettic"},
            {password, ""},
            {database, "gettic_db"}
        ]},
        {redis, [
            {host, ""},
            {port, 6379},
            {database, 0}
        ]},
        {security, [
            {jwt_secret, ""},
            {token_expiry, 3600},
            {refresh_token_expiry, 2592000}
        ]},
        {rate_limit, [
            {max_requests, 100},
            {window_seconds, 60}
        ]}
    ]},
    {lager, [
        {handlers, [
            {lager_console_backend, [
                {level, info},
                {formatter, lager_default_formatter},
                {formatter_config, [time, " ", message, "\n"]}
            ]},
            {lager_file_backend, [
                {file, "log/gettic.log"},
                {level, info},
                {size, 10485760},
                {date, "$D0"},
                {count, 5}
            ]}
        ]}
    ]}
].
