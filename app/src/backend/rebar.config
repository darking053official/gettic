{erl_opts, [debug_info]}.

{deps, [
    {cowboy, "2.10.0"},
    {jsx, "3.1.0"},
    {mysql, "1.8.0"},
    {eredis, "1.7.0"},
    {lager, "3.9.2"}
]}.

{relx, [
    {release, {gettic, "0.1.0"},
        [gettic, sasl]},
    {dev_mode, true},
    {include_erts, false},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [
        {relx, [
            {dev_mode, false},
            {include_erts, true}
        ]}
    ]}
]}.
