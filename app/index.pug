doctype html
html(lang="tr")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover")
    meta(name="theme-color" content="#c94d8c")
    link(rel="icon" href="https://raw.githubusercontent.com/darking053official/gettic/main/1777062266055.png")
    title Gettic
    link(rel="stylesheet" href="css/all.css")
  body
    noscript
      div(style="padding:20px;text-align:center;background:#c94d8c;color:#fff") JavaScript gerekli
    #root
      #ls
        .spin
        .ls-logo gettic
    
    script(src="https://cdn.socket.io/4.7.5/socket.io.min.js")
    script(src="https://unpkg.com/react@18/umd/react.production.min.js")
    script(src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js")
    script(src="https://unpkg.com/@babel/standalone/babel.min.js")
    script(type="text/babel" src="js/app.js")
    
    script.
      window.onload = function() {
        if (typeof App === 'function') {
          const root = ReactDOM.createRoot(document.getElementById('root'));
          root.render(React.createElement(App));
          setTimeout(function() {
            var ls = document.getElementById('ls');
            if (ls) ls.classList.add('hide');
          }, 800);
        }
      };
