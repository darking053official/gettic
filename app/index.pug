doctype html
html(lang="tr")
  head
    meta(charset="UTF-8")
    meta(http-equiv="X-UA-Compatible" content="IE=edge")
    meta(name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover")
    meta(name="description" content="Gettic - Modern Türkçe sohbet platformu.")
    meta(name="keywords" content="sohbet, chat, gettic, türkçe")
    meta(name="author" content="Gettic")
    meta(name="robots" content="index, follow")
    meta(name="theme-color" content="#c94d8c")
    meta(property="og:title" content="Gettic - Modern Sohbet Platformu")
    meta(property="og:image" content="https://raw.githubusercontent.com/darking053official/gettic/main/1777062266055.png")
    meta(property="og:url" content="https://gettic.js.org")
    meta(property="og:type" content="website")
    meta(name="twitter:card" content="summary_large_image")
    meta(name="twitter:title" content="Gettic")
    link(rel="canonical" href="https://gettic.js.org")
    link(rel="icon" href="https://raw.githubusercontent.com/darking053official/gettic/main/1777062266055.png")
    link(rel="apple-touch-icon" href="https://raw.githubusercontent.com/darking053official/gettic/main/1777062266055.png")
    link(rel="manifest" href="/manifest.json")
    title Gettic - Sohbet Platformu
    
    // CSS dosyaları
    link(rel="stylesheet" href="css/variables.css")
    link(rel="stylesheet" href="css/reset.css")
    link(rel="stylesheet" href="css/layout.css")
    link(rel="stylesheet" href="css/sidebar.css")
    link(rel="stylesheet" href="css/chat.css")
    link(rel="stylesheet" href="css/modals.css")
    link(rel="stylesheet" href="css/responsive.css")
    
  body
    noscript
      div(style="padding:20px;text-align:center;background:#c94d8c;color:#fff;font-family:sans-serif;") Gettic çalışmak için JavaScript gerektirir. Lütfen JavaScript'i etkinleştirin.
    
    #root
      #ls
        .spin
        .ls-logo gettic
    
    // Kütüphaneler
    script(src="https://cdn.socket.io/4.7.5/socket.io.min.js")
    script(src="https://unpkg.com/react@18/umd/react.production.min.js" crossorigin)
    script(src="https://unpkg.com/react-dom@18/umd/react-dom.production.min.js" crossorigin)
    script(src="https://unpkg.com/@babel/standalone/babel.min.js")
    
    // Uygulama JS dosyaları
    script(src="js/config.js")
    script(src="js/icons.js")
    script(src="js/roles.js")
    script(src="js/auth.js")
    script(src="js/chat.js")
    script(src="js/channels.js")
    script(src="js/dm.js")
    script(src="js/voice.js")
    script(src="js/polls.js")
    script(src="js/ui.js")
    script(type="text/babel" src="js/app.js")
    
    script.
      window.onload = function() {
        if (typeof App === 'function') {
          const root = ReactDOM.createRoot(document.getElementById('root'));
          root.render(React.createElement(App));
          setTimeout(function() {
            var ls = document.getElementById('ls');
            if (ls) ls.classList.add('hide');
          }, 800);
        }
      };
