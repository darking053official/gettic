<div id="toast">✓ Kopyalandı!</div>

<script>
(function(){
"use strict";
var API = window.location.origin;
if(window.location.hostname==='localhost') API = 'http://localhost:3000';
var me = null, token = localStorage.getItem('gt_token') || null;

// ========== LOADING ==========
setTimeout(function(){
    document.getElementById('loading-screen').classList.add('hidden');
    if(token){ try{ me = JSON.parse(localStorage.getItem('gt_user')); updateNav(); }catch(e){ localStorage.clear(); } }
},1500);

// ========== AUTH ==========
function showAuth(tab){
    document.getElementById('auth-modal').classList.add('show');
    if(tab==='register'){ document.getElementById('auth-form-register').style.display=''; document.getElementById('auth-form-login').style.display='none'; }
}
function switchAuthTab(tab){
    document.getElementById('auth-form-login').style.display = tab==='login'?'':'none';
    document.getElementById('auth-form-register').style.display = tab==='register'?'':'none';
    document.querySelectorAll('.auth-tab').forEach(function(b,i){ b.classList.toggle('active', (i===0)===(tab==='login')); });
}
function toggleAuthForm(){
    var reg = document.getElementById('auth-form-register');
    if(reg.style.display==='none'){ switchAuthTab('register'); }else{ switchAuthTab('login'); }
}
async function doLogin(){
    var u=document.getElementById('login-user').value.trim(), p=document.getElementById('login-pass').value;
    if(!u||!p) return document.getElementById('login-err').textContent='Tüm alanları doldur';
    try{
        var res = await fetch(API+'/api/auth/login',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:u,password:p})});
        var d = await res.json();
        if(d.error) return document.getElementById('login-err').textContent=d.error;
        me=d.user; token=d.token;
        localStorage.setItem('gt_token',token); localStorage.setItem('gt_user',JSON.stringify(me));
        document.getElementById('auth-modal').classList.remove('show');
        updateNav();
    }catch(e){ document.getElementById('login-err').textContent='Bağlantı hatası'; }
}
async function doRegister(){
    var u=document.getElementById('reg-user').value.trim(), p=document.getElementById('reg-pass').value;
    if(!u||!p) return document.getElementById('reg-err').textContent='Tüm alanları doldur';
    if(u.length<3) return document.getElementById('reg-err').textContent='En az 3 karakter';
    if(p.length<6) return document.getElementById('reg-err').textContent='En az 6 karakter';
    try{
        var res = await fetch(API+'/api/auth/register',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({username:u,password:p})});
        var d = await res.json();
        if(d.error) return document.getElementById('reg-err').textContent=d.error;
        me=d.user; token=d.token;
        localStorage.setItem('gt_token',token); localStorage.setItem('gt_user',JSON.stringify(me));
        document.getElementById('auth-modal').classList.remove('show');
        updateNav();
    }catch(e){ document.getElementById('reg-err').textContent='Bağlantı hatası'; }
}
function doLogout(){ localStorage.clear(); me=null; token=null; updateNav(); }
function updateNav(){
    if(me){ document.getElementById('btn-login').style.display='none'; document.getElementById('btn-logout').style.display=''; }
    else{ document.getElementById('btn-login').style.display=''; document.getElementById('btn-logout').style.display='none'; }
}

// ========== DOCS ==========
function showDoc(id){
    document.querySelectorAll('.doc-pane').forEach(function(p){ p.classList.toggle('on', p.id==='dp-'+id); });
    document.querySelectorAll('.dni').forEach(function(d){ d.classList.toggle('on', d.getAttribute('onclick')===`showDoc('${id}')`); });
}

// ========== CODE TABS ==========
function showTab(id){
    document.querySelectorAll('.cs-body').forEach(function(b){ b.classList.toggle('on', b.id==='t-'+id); });
    document.querySelectorAll('.cs-tab').forEach(function(t){ t.classList.toggle('on', t.getAttribute('onclick')===`showTab('${id}')`); });
}
function copyCode(btn){
    var code = [...btn.parentElement.querySelectorAll('.ln')].map(function(l){ return l.textContent; }).join('\n');
    navigator.clipboard.writeText(code).then(function(){ btn.textContent='✓ Kopyalandı'; setTimeout(function(){ btn.textContent='Kopyala'; },2000); });
}

// ========== DEMO PANEL ==========
function genTok(pre){ return pre+'_'+Array.from({length:24},function(){ return 'abcdefghijklmnopqrstuvwxyz0123456789'[Math.floor(Math.random()*36)]; }).join(''); }
function demoBot(){
    var n=document.getElementById('bn').value.trim(); if(!n) return alert('Bot adı gerekli!');
    var tok=genTok('bot'), el=document.getElementById('bt'); el.textContent=tok; el.classList.add('show'); toast('Bot oluşturuldu! (Demo)');
}
function demoWh(){
    var n=document.getElementById('wn').value.trim(), c=document.getElementById('wc').value.trim();
    if(!n||!c) return alert('Ad ve kanal gerekli!');
    var url=API+'/api/webhook/'+genTok('wh'), el=document.getElementById('wu'); el.textContent=url; el.classList.add('show'); toast('Webhook oluşturuldu! (Demo)');
}

// ========== TOAST ==========
function toast(msg){
    var t=document.getElementById('toast'); t.textContent=msg; t.classList.add('show');
    setTimeout(function(){ t.classList.remove('show'); },2500);
}

// ========== COPY ==========
function copyNpm(){ navigator.clipboard.writeText('npm install gettic.js').then(function(){ document.getElementById('ncp').textContent='✓'; setTimeout(function(){ document.getElementById('ncp').textContent='Kopyala'; },2000); toast('Kopyalandı!'); }); }
function copyText(t){ navigator.clipboard.writeText(t.trim()).then(function(){ toast('Kopyalandı!'); }); }

// ========== GLOBAL ==========
window.showAuth=showAuth; window.doLogin=doLogin; window.doRegister=doRegister;
window.doLogout=doLogout; window.switchAuthTab=switchAuthTab; window.toggleAuthForm=toggleAuthForm;
window.showDoc=showDoc; window.showTab=showTab; window.copyCode=copyCode;
window.demoBot=demoBot; window.demoWh=demoWh; window.copyText=copyText; window.copyNpm=copyNpm;

// ========== CLOSE MODAL ON BG CLICK ==========
document.addEventListener('click',function(e){ if(e.target.id==='auth-modal') e.target.classList.remove('show'); });
document.addEventListener('keydown',function(e){ if(e.key==='Escape') document.getElementById('auth-modal').classList.remove('show'); });
})();
</script>
