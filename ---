<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="theme-color" content="#0a0a12">
    <title>Gettic — Modern Bot Framework | gettic.js.org</title>
    <meta name="description" content="gettic.js ile dakikalar içinde kendi botunu yaz. Modern sohbet platformu için bot framework.">
    <meta property="og:title" content="Gettic — Modern Bot Framework">
    <meta property="og:description" content="gettic.js ile kendi botunu dakikalar içinde yaz.">
    <meta property="og:image" content="https://raw.githubusercontent.com/darking053official/gettic/main/1777062266055.png">
    <meta property="og:url" content="https://gettic.js.org">
    <link rel="icon" href="https://raw.githubusercontent.com/darking053official/gettic/main/1777062266055.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <script src="https://cdn.socket.io/4.7.2/socket.io.min.js"></script>
    <style>
        :root {
            --bg: #04040e; --bg1: #08081a; --bg2: #0d0d24; --bg3: #12122e;
            --b: rgba(100,100,255,.1); --b2: rgba(100,100,255,.2); --b3: rgba(100,100,255,.35);
            --ac: #6366f1; --ac2: #818cf8; --ac3: #a5b4fc; --ac4: #c7d2fe;
            --acg: rgba(99,102,241,.3); --acd: rgba(99,102,241,.12);
            --t1: #f0f0ff; --t2: #9090b8; --t3: #4a4a6a;
            --gr: #22c55e; --re: #ef4444; --ye: #f59e0b; --pu: #a855f7;
            --mono: 'JetBrains Mono', monospace; --sans: 'Outfit', sans-serif;
            --radius: 12px; --shadow: 0 8px 30px rgba(0,0,0,0.4);
        }
        *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
        html{scroll-behavior:smooth;overflow-x:hidden}
        body{font-family:var(--sans);background:var(--bg);color:var(--t1);overflow-x:hidden;min-height:100vh}
        ::-webkit-scrollbar{width:4px}::-webkit-scrollbar-thumb{background:var(--ac);border-radius:99px}

        /* ========== LOADING ========== */
        #loading-screen{position:fixed;inset:0;background:var(--bg);z-index:9999;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:24px;transition:opacity 0.5s,visibility 0.5s}
        #loading-screen.hidden{opacity:0;visibility:hidden;pointer-events:none}
        .loader{transform:rotateZ(45deg);perspective:1000px;border-radius:50%;width:48px;height:48px;color:var(--ac)}
        .loader:before,.loader:after{content:'';display:block;position:absolute;top:0;left:0;width:inherit;height:inherit;border-radius:50%;transform:rotateX(70deg);animation:spin 1s linear infinite}
        .loader:after{color:var(--pu);transform:rotateY(70deg);animation-delay:.4s}
        @keyframes spin{0%,100%{box-shadow:.2em 0px 0 0px currentcolor}12%{box-shadow:.2em .2em 0 0 currentcolor}25%{box-shadow:0 .2em 0 0px currentcolor}37%{box-shadow:-.2em .2em 0 0 currentcolor}50%{box-shadow:-.2em 0 0 0 currentcolor}62%{box-shadow:-.2em -.2em 0 0 currentcolor}75%{box-shadow:0px -.2em 0 0 currentcolor}87%{box-shadow:.2em -.2em 0 0 currentcolor}}
        .loading-text{font-family:var(--mono);font-size:13px;color:var(--t3);animation:pulse-text 1.5s ease infinite}
        @keyframes pulse-text{0%,100%{opacity:0.4}50%{opacity:1}}

        /* ========== NAVBAR ========== */
        nav{position:fixed;top:0;left:0;right:0;z-index:500;height:64px;display:flex;align-items:center;padding:0 32px;transition:all .4s;background:rgba(4,4,14,.88);backdrop-filter:blur(20px);border-bottom:1px solid var(--b)}
        .nav-logo{display:flex;align-items:center;gap:10px;font-size:19px;font-weight:800;letter-spacing:-.5px;text-decoration:none}
        .nav-logo img{width:30px;height:30px;border-radius:8px}
        .nav-logo .gt{background:linear-gradient(135deg,var(--ac2),var(--ac3));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
        .nav-links{display:flex;align-items:center;gap:24px;margin-left:auto}
        .nav-link{font-size:13px;font-weight:500;color:var(--t2);text-decoration:none;transition:color .2s;cursor:pointer;background:none;border:none;font-family:var(--sans)}
        .nav-link:hover{color:var(--t1)}
        .nav-btn{padding:8px 18px;border-radius:99px;font-size:12px;font-weight:600;cursor:pointer;font-family:var(--sans);transition:all .3s;text-decoration:none;display:inline-flex;align-items:center;gap:6px}
        .nav-btn-login{background:none;border:1px solid var(--b2);color:var(--t1)}
        .nav-btn-login:hover{background:var(--bg2)}
        .nav-btn-app{background:linear-gradient(135deg,var(--ac),var(--pu));border:none;color:#fff;box-shadow:0 0 20px var(--acg)}
        .nav-btn-app:hover{transform:translateY(-2px);box-shadow:0 0 40px var(--acg)}
        .nav-btn-logout{background:rgba(239,68,68,0.15);border:1px solid rgba(239,68,68,0.2);color:var(--re);display:none}

        /* ========== AUTH MODAL ========== */
        #auth-modal{position:fixed;inset:0;background:rgba(0,0,0,0.8);backdrop-filter:blur(8px);z-index:800;display:none;align-items:center;justify-content:center}
        #auth-modal.show{display:flex}
        .auth-box{background:var(--bg2);border:1px solid var(--b2);border-radius:20px;padding:40px 36px;width:400px;max-width:94vw;box-shadow:var(--shadow);animation:modal-in .3s ease}
        @keyframes modal-in{from{opacity:0;transform:scale(0.95) translateY(20px)}to{opacity:1;transform:scale(1) translateY(0)}}
        .auth-box h2{font-size:22px;font-weight:800;margin-bottom:6px;text-align:center}
        .auth-box .sub{font-size:13px;color:var(--t3);text-align:center;margin-bottom:24px}
        .auth-tabs{display:flex;background:var(--bg);border-radius:10px;padding:3px;margin-bottom:20px;gap:3px}
        .auth-tab{flex:1;padding:10px;background:none;border:none;color:var(--t3);font-size:13px;font-weight:600;border-radius:8px;cursor:pointer;font-family:var(--sans);transition:all .2s}
        .auth-tab.active{background:var(--ac);color:#fff}
        .auth-field{margin-bottom:14px}
        .auth-field label{display:block;font-size:11px;font-weight:600;color:var(--t2);text-transform:uppercase;letter-spacing:.8px;margin-bottom:6px}
        .auth-field input{width:100%;padding:12px 14px;background:var(--bg);border:1px solid var(--b);border-radius:10px;color:var(--t1);font-size:14px;font-family:var(--sans);outline:none;transition:border-color .2s}
        .auth-field input:focus{border-color:var(--ac)}
        .auth-btn{width:100%;padding:13px;background:linear-gradient(135deg,var(--ac),var(--pu));border:none;border-radius:10px;color:#fff;font-size:14px;font-weight:700;cursor:pointer;font-family:var(--sans);transition:all .3s}
        .auth-btn:hover{transform:translateY(-2px);box-shadow:0 4px 20px var(--acg)}
        .auth-error{color:var(--re);font-size:12px;text-align:center;margin-top:8px;min-height:18px}
        .auth-switch{text-align:center;font-size:12px;color:var(--t3);margin-top:12px}
        .auth-switch span{color:var(--ac3);cursor:pointer;font-weight:600}

        /* ========== HERO ========== */
        .hero{min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:120px 24px 60px;position:relative;z-index:1}
        .hero-badge{display:inline-flex;align-items:center;gap:8px;padding:7px 16px;background:var(--acd);border:1px solid var(--b2);border-radius:99px;font-size:12px;font-weight:600;color:var(--ac3);margin-bottom:32px}
        .badge-dot{width:7px;height:7px;border-radius:50%;background:var(--gr);animation:pulse-dot 2s infinite}
        @keyframes pulse-dot{0%,100%{box-shadow:0 0 0 0 rgba(34,197,94,.6)}50%{box-shadow:0 0 0 6px rgba(34,197,94,0)}}
        .hero-title{font-size:clamp(46px,8vw,100px);font-weight:900;line-height:1;letter-spacing:-3px;margin-bottom:24px}
        .grad-text{background:linear-gradient(135deg,#fff 0%,var(--ac3) 40%,var(--pu) 80%,#fff 100%);background-size:200% 200%;-webkit-background-clip:text;-webkit-text-fill-color:transparent;animation:grad-shift 4s ease infinite}
        @keyframes grad-shift{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
        .hero-sub{font-size:clamp(16px,2vw,20px);color:var(--t2);max-width:580px;line-height:1.65;margin-bottom:40px}
        .hero-btns{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
        .btn-a{padding:14px 32px;background:linear-gradient(135deg,var(--ac),var(--pu));border-radius:12px;font-size:15px;font-weight:700;color:#fff;text-decoration:none;transition:all .3s;box-shadow:0 0 30px var(--acg);display:inline-flex;align-items:center;gap:8px}
        .btn-a:hover{transform:translateY(-3px);box-shadow:0 0 60px var(--acg)}
        .btn-b{padding:14px 32px;background:transparent;border:1px solid var(--b2);border-radius:12px;font-size:15px;font-weight:700;color:var(--t1);text-decoration:none;transition:all .3s;display:inline-flex;align-items:center;gap:8px}
        .btn-b:hover{border-color:var(--b3);transform:translateY(-3px);background:var(--acd)}
        .hero-npm{margin-top:28px}
        .npm-pill{display:inline-flex;align-items:center;gap:12px;padding:11px 20px;background:var(--bg2);border:1px solid var(--b);border-radius:10px;font-family:var(--mono);font-size:13px;color:var(--ac3);cursor:pointer;transition:all .3s}
        .npm-pill:hover{border-color:var(--b2);background:var(--bg3)}
        .npm-cp{font-family:var(--sans);font-size:10px;font-weight:700;padding:3px 8px;background:var(--acd);border-radius:5px;color:var(--ac3)}

        /* ========== FEATURES ========== */
        section{padding:100px 24px;position:relative;z-index:1}
        .container{max-width:1100px;margin:0 auto}
        .sec-badge{display:inline-block;padding:5px 13px;background:var(--acd);border:1px solid var(--b2);border-radius:99px;font-size:11px;font-weight:700;color:var(--ac3);text-transform:uppercase;letter-spacing:1px;margin-bottom:18px}
        .sec-title{font-size:clamp(30px,5vw,52px);font-weight:800;letter-spacing:-1.5px;line-height:1.05;margin-bottom:14px}
        .sec-sub{font-size:17px;color:var(--t2);max-width:520px;line-height:1.7}
        .feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--b);border:1px solid var(--b);border-radius:20px;overflow:hidden;margin-top:60px}
        .feat{background:var(--bg1);padding:32px;transition:all .4s;position:relative;overflow:hidden}
        .feat::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 0% 0%,var(--acd),transparent 60%);opacity:0;transition:opacity .4s}
        .feat:hover{background:var(--bg2)}.feat:hover::before{opacity:1}
        .feat-ico{font-size:28px;margin-bottom:18px;display:block;position:relative;z-index:1;transition:transform .3s}
        .feat:hover .feat-ico{transform:scale(1.15) rotate(-5deg)}
        .feat-t{font-size:17px;font-weight:700;margin-bottom:8px;position:relative;z-index:1}
        .feat-d{font-size:13px;color:var(--t2);line-height:1.7;position:relative;z-index:1}

        /* ========== CODE SHOWCASE ========== */
        .code-showcase{background:var(--bg1);border:1px solid var(--b);border-radius:20px;overflow:hidden;margin-top:60px;position:relative}
        .cs-tabs{display:flex;background:var(--bg);border-bottom:1px solid var(--b);padding:0 20px;gap:4px}
        .cs-tab{padding:13px 16px;font-size:12px;font-weight:600;color:var(--t3);cursor:pointer;border-bottom:2px solid transparent;transition:all .25s;font-family:var(--mono);display:flex;align-items:center;gap:7px}
        .cs-tab.on{color:var(--ac3);border-color:var(--ac)}
        .cs-body{padding:28px;font-family:var(--mono);font-size:13px;line-height:1.85;display:none;position:relative}
        .cs-body.on{display:block}
        .cs-body .ln{display:block;white-space:pre}
        .kw{color:#c792ea}.fn{color:#82aaff}.str{color:#c3e88d}.cm{color:#546e7a;font-style:italic}.nm{color:#f78c6c}.op{color:#89ddff}.pl{color:#ffcb6b}.nu{color:#f78c6c}
        .cs-copy{position:absolute;top:16px;right:16px;padding:6px 12px;background:var(--bg2);border:1px solid var(--b);border-radius:6px;font-size:11px;font-weight:600;color:var(--t3);cursor:pointer;font-family:var(--sans);transition:all .2s}
        .cs-copy:hover{background:var(--acd);color:var(--ac3);border-color:var(--b2)}

        /* ========== DOCS ========== */
        .docs-wrap{display:grid;grid-template-columns:200px 1fr;gap:28px;margin-top:56px;align-items:start}
        .docs-nav{position:sticky;top:84px;background:var(--bg1);border:1px solid var(--b);border-radius:14px;padding:12px;overflow:hidden}
        .dns{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:1px;color:var(--t3);padding:10px 10px 4px}
        .dni{padding:8px 10px;border-radius:7px;font-size:13px;color:var(--t2);cursor:pointer;transition:all .2s;display:flex;align-items:center;gap:7px}
        .dni:hover{background:var(--bg2);color:var(--t1)}.dni.on{background:var(--acd);color:var(--ac3)}
        .doc-pane{display:none}.doc-pane.on{display:block}
        .doc-h{font-size:26px;font-weight:800;letter-spacing:-.5px;margin-bottom:8px}
        .doc-lead{font-size:15px;color:var(--t2);margin-bottom:28px;line-height:1.7}
        .doc-card{background:var(--bg1);border:1px solid var(--b);border-radius:12px;padding:22px;margin-bottom:16px}
        .doc-card h3{font-size:13px;font-weight:700;color:var(--ac3);margin-bottom:10px;font-family:var(--mono)}
        .doc-card p{font-size:13px;color:var(--t2);line-height:1.75;margin-bottom:10px}
        pre{background:var(--bg);border:1px solid var(--b);border-radius:8px;padding:16px;font-family:var(--mono);font-size:12px;line-height:1.8;overflow-x:auto;color:var(--t1);margin:8px 0}
        code{font-family:var(--mono);font-size:12px;background:var(--bg2);padding:2px 6px;border-radius:4px;color:var(--ac3)}
        .tbl{width:100%;border-collapse:collapse;font-size:13px;margin:10px 0}
        .tbl th{text-align:left;padding:8px 12px;background:var(--bg);color:var(--t3);font-size:10px;text-transform:uppercase;letter-spacing:.5px;font-weight:700}
        .tbl td{padding:9px 12px;border-bottom:1px solid var(--b);color:var(--t2)}
        .tbl td:first-child{font-family:var(--mono);color:var(--t1);font-size:12px}
        .mb{display:inline-block;padding:2px 7px;border-radius:4px;font-size:10px;font-weight:700;margin-right:3px}
        .get{background:rgba(34,197,94,.15);color:var(--gr)}.post{background:var(--acd);color:var(--ac3)}.del{background:rgba(239,68,68,.15);color:var(--re)}

        /* ========== PANEL ========== */
        .panel-shell{background:var(--bg1);border:1px solid var(--b);border-radius:20px;overflow:hidden;margin-top:56px;position:relative}
        .panel-bar{background:var(--bg);border-bottom:1px solid var(--b);padding:12px 20px;display:flex;align-items:center;gap:8px}
        .pbd{width:11px;height:11px;border-radius:50%}
        .panel-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;padding:24px}
        .pc{background:var(--bg);border:1px solid var(--b);border-radius:13px;padding:20px;transition:all .3s}
        .pc:hover{border-color:var(--b2)}
        .pc-head{display:flex;align-items:center;gap:10px;margin-bottom:14px}
        .pc-ico{width:36px;height:36px;border-radius:9px;background:var(--acd);display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0}
        .pc-nm{font-size:13px;font-weight:700}.pc-sb{font-size:11px;color:var(--t3);margin-top:1px}
        .pi{width:100%;padding:9px 11px;background:var(--bg1);border:1px solid var(--b);border-radius:7px;color:var(--t1);font-family:var(--sans);font-size:13px;transition:border-color .2s;margin-bottom:8px}
        .pi:focus{outline:none;border-color:var(--ac)}
        .pb{width:100%;padding:9px;background:linear-gradient(135deg,var(--ac),var(--pu));border:none;border-radius:7px;color:#fff;font-weight:700;font-size:13px;cursor:pointer;font-family:var(--sans);transition:all .3s}
        .pb:hover{transform:translateY(-1px)}
        .tok-box{background:var(--bg1);border:1px solid var(--b);border-radius:6px;padding:8px 11px;font-family:var(--mono);font-size:11px;color:var(--t2);cursor:pointer;word-break:break-all;transition:border-color .2s;margin-top:10px;display:none}
        .tok-box.show{display:block}

        /* ========== FOOTER ========== */
        footer{border-top:1px solid var(--b);background:var(--bg);padding:56px 24px;position:relative;z-index:1}
        .foot-inner{max-width:1100px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px}
        .foot-brand{display:flex;align-items:center;gap:10px;font-size:18px;font-weight:800}
        .foot-brand .gt{background:linear-gradient(135deg,var(--ac2),var(--ac3));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
        .foot-copy{font-size:12px;color:var(--t3)}

        /* ========== TOAST ========== */
        #toast{position:fixed;bottom:24px;right:24px;z-index:999;padding:11px 20px;background:var(--bg2);border:1px solid var(--b2);border-radius:10px;font-size:13px;font-weight:600;color:var(--gr);opacity:0;transform:translateY(10px);transition:all .3s;pointer-events:none;box-shadow:var(--shadow)}
        #toast.show{opacity:1;transform:translateY(0)}

        @media(max-width:960px){.feat-grid{grid-template-columns:repeat(2,1fr)}.docs-wrap{grid-template-columns:1fr}.docs-nav{position:relative;top:0;display:flex;flex-wrap:wrap;gap:5px;padding:8px}.dns{display:none}.dni{padding:5px 10px;font-size:12px}.panel-grid{grid-template-columns:1fr}}
        @media(max-width:640px){nav{padding:0 20px}.feat-grid{grid-template-columns:1fr}.hero-stats{gap:28px}section{padding:72px 20px}}
    </style>
</head>
<body>

<!-- LOADING -->
<div id="loading-screen">
    <div class="loader"></div>
    <div class="loading-text">Gettic yükleniyor...</div>
</div>

<!-- AUTH MODAL -->
<div id="auth-modal">
    <div class="auth-box">
        <h2 id="auth-title">Giriş Yap</h2>
        <p class="sub">Gettic hesabınla devam et</p>
        <div class="auth-tabs">
            <button class="auth-tab active" onclick="switchAuthTab('login')">Giriş</button>
            <button class="auth-tab" onclick="switchAuthTab('register')">Kayıt</button>
        </div>
        <div id="auth-form-login">
            <div class="auth-field"><label>Kullanıcı Adı</label><input type="text" id="login-user" placeholder="kullanıcı_adın" autocomplete="username"></div>
            <div class="auth-field"><label>Şifre</label><input type="password" id="login-pass" placeholder="••••••••" autocomplete="current-password"></div>
            <button class="auth-btn" onclick="doLogin()">Giriş Yap</button>
            <div class="auth-error" id="login-err"></div>
        </div>
        <div id="auth-form-register" style="display:none">
            <div class="auth-field"><label>Kullanıcı Adı</label><input type="text" id="reg-user" placeholder="kullanıcı_adın" autocomplete="username"></div>
            <div class="auth-field"><label>Şifre</label><input type="password" id="reg-pass" placeholder="En az 6 karakter" autocomplete="new-password"></div>
            <button class="auth-btn" onclick="doRegister()">Kayıt Ol</button>
            <div class="auth-error" id="reg-err"></div>
        </div>
        <p class="auth-switch"><span onclick="toggleAuthForm()">Hesabın var mı? / Hesabın yok mu?</span></p>
    </div>
</div>

<!-- NAV -->
<nav>
    <a href="#" class="nav-logo">
        <img src="https://raw.githubusercontent.com/darking053official/gettic/main/1777062266055.png" alt="Gettic" onerror="this.style.display='none'">
        <span class="gt">gettic</span>
    </a>
    <div class="nav-links">
        <a href="#features" class="nav-link">Özellikler</a>
        <a href="#install" class="nav-link">Kurulum</a>
        <a href="#docs" class="nav-link">Docs</a>
        <a href="#panel" class="nav-link">Panel</a>
        <button class="nav-btn nav-btn-login" id="btn-login" onclick="showAuth('login')">Giriş</button>
        <button class="nav-btn nav-btn-logout" id="btn-logout" onclick="doLogout()">Çıkış</button>
        <a href="/app" class="nav-btn nav-btn-app">Gettic'e Git →</a>
    </div>
</nav>

<!-- HERO -->
<section class="hero">
    <div class="hero-badge"><span class="badge-dot"></span> gettic.js.org'a hoş geldin</div>
    <h1 class="hero-title">
        <span class="grad-text">Bot framework</span><br>modern platform için
    </h1>
    <p class="hero-sub">gettic.js ile kendi botunu dakikalar içinde yaz. Komutlar, olaylar, webhook — hepsi tek pakette, sıfır yapılandırma.</p>
    <div class="hero-btns">
        <a href="#install" class="btn-a">⚡ Hemen Başla</a>
        <a href="#docs" class="btn-b">📖 Dokümantasyon</a>
    </div>
    <div class="hero-npm">
        <div class="npm-pill" onclick="copyNpm()">
            <span style="color:var(--t3)">$</span>
            <span>npm install gettic.js</span>
            <span class="npm-cp" id="ncp">Kopyala</span>
        </div>
    </div>
</section>

<!-- FEATURES -->
<section id="features">
    <div class="container">
        <span class="sec-badge">Özellikler</span>
